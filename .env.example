# Authentication and persistence (Firebase Admin)
# Copy this file to .env.local and replace the values with your own.
# Paste the full JSON for your Firebase service account as a single line.
FIREBASE_SERVICE_ACCOUNT="{\"type\":\"service_account\",...}"
JWT_SECRET="change-this-to-a-long-random-secret"

# Optional runtime config
GEMINI_API_KEY="MY_GEMINI_API_KEY"
APP_URL="https://your-deployment.vercel.app"
